# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
# Leave AZURE_OPENAI_ENDPOINT or AZURE_OPENAI_API_KEY empty to run in demo mode,
# where the scripted handler in src/pagecraft/demo.py stands in for the LLM.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
# The deployment name in your Azure resource, not the base model name.
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Under docker compose this is overridden to /app/data/pagecraft.db.
PAGECRAFT_DB_PATH=./data/pagecraft.db
PAGECRAFT_HOST=0.0.0.0
PAGECRAFT_PORT=8000

# Keep false in production. Only enable locally.
PAGECRAFT_DEBUG=false

# Public origin the app is reached on, e.g. https://pagecraft.example.org
# behind a reverse proxy. Currently read into Settings but not yet used to
# build links; preview and case URLs are relative.
PAGECRAFT_BASE_URL=http://localhost:8000

# Optional. If set, substituted for {{INFO_URL}} in prompts/opening.md so the
# opening message can link to a project information page. If empty, the line
# referencing it is dropped from the opening.
PAGECRAFT_INFO_URL=
